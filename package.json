{
  "version": "1.6.0-dev",
  "name": "tuvero-web",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "cli",
    "libtuvero"
  ],
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "diff": "^9.0.0",
    "file-saver": "^2.0.5",
    "jquery": "^3.7.1",
    "normalize.css": "^8.0.1",
    "semver": "~4.3.6",
    "standard": "^17.1.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "npm run vite:build",
    "vite:dev": "vite",
    "vite:build": "npm run vite:build:basic && npm run vite:build:boule && npm run vite:build:tac",
    "vite:build:basic": "VITE_VARIANT=basic vite build",
    "vite:build:boule": "VITE_VARIANT=boule vite build",
    "vite:build:tac": "VITE_VARIANT=tac vite build",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:watch": "SLOWMO=250 playwright test --headed --workers=1",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "dev": "vite"
  },
  "standard": {
    "ignore": [
      "**/lib/**",
      "**/dist/**",
      "build/**",
      "tmp/**",
      "scripts/core/common.js",
      "**/{require,qunit}.js"
    ]
  }
}
